# fishball-sdr-7020 additions on top of zynq_pluto_defconfig
CONFIG_SYS_CONFIG_NAME="zynq_fishball_sdr"
CONFIG_DEFAULT_DEVICE_TREE="zynq-fishball-sdr-7020"
CONFIG_SYS_PROMPT="fishball> "
CONFIG_CMD_MMC=y
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ZYNQ=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_DOS_PARTITION=y
CONFIG_FS_FAT=y
CONFIG_CMD_NET=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_NET=y
CONFIG_DM_ETH=y
CONFIG_ZYNQ_GEM=y
CONFIG_PHYLIB=y
CONFIG_PHY_REALTEK=y
CONFIG_PHY_MARVELL=y
CONFIG_SYS_DFU_DATA_BUF_SIZE=0x600000
# Pluto-only: adi_hwref probes Pluto revision straps and misc_init_r treats
# MIO14 as a factory-reset button, which fishball does not have.
# CONFIG_CMD_ADI_HWREF is not set
# CONFIG_MISC_INIT_R is not set
CONFIG_VERSION_VARIABLE=y
# pick qspiboot/sdboot/jtagboot from the boot-mode straps
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
