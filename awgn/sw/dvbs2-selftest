#!/bin/sh
# dvbs2-selftest: end-to-end loopback test of the PL DVB-S2 transmitter and
# receiver: PRBS transport stream -> dvbs2-tx -> AD9363 loopback -> PL noise
# source (rx-awgn, sets Es/N0) -> dvbs2-rx -> packet check.
#
#   -L digital   AD9363 data-port loopback TX1 -> RX1 (BIST loopback 1): exact
#                samples, no RF, nothing radiated (default)
#   -L rf        external RF loopback: TX1 cabled to RX1 through an attenuator
#                (30 dB or more); TX and RX LO at -f (RX LO + -d), TX attenuation
#                -a, RX gain -G (default AGC). Without a cable it relies on
#                coupling between the ports / antennas: it transmits.
#
# usage: dvbs2-selftest [-L digital|rf] [-s SYMRATE] [-m MODCOD] [-p]
#                       [-e "ESN0 ..."] [-t SEC] [-w SEC] [-o NCO_HZ] [-r ROLLOFF]
#                       [-f LO_HZ] [-d RX_LO_OFFSET_HZ] [-a TX_ATTEN_DB] [-G RX_GAIN_DB]
#   -s  symbol rate (default 1000000), 12 MS/s / (2 x 1..32): the transmitter
#       interpolates by at most 64, the receiver supports all of these
#   -e  Es/N0 points in dB, "off" for no added noise (default "off 1 0 -1 -2")
#   -t  counting time per point (default 10 s), -w warm-up (default 3 s)
#   -o  transmitter NCO offset (a carrier offset for the receiver, which is
#       told nothing about it)
#   -r  roll-off 0.35 (default), 0.25 or 0.20
#
# Prints per point: Es/N0 set, packets ok / bad / lost, packet error rate, and
# the receiver's last status line.

L=digital SR=1000000 MC=qpsk1/4 P= ES="off 1 0 -1 -2" T=10 W=3 NCO=0 RO=0.35
LO=2400250000 DLO=0 ATT=40 GAIN=
FS=12000000

die() { echo "dvbs2-selftest: $*" >&2; exit 1; }
usage() { sed -n '2,26s/^# \{0,1\}//p' "$0" >&2; exit 2; }

while getopts "L:s:m:pe:t:w:o:f:d:a:G:r:h" o; do
	case $o in
	L) L=$OPTARG ;;
	s) SR=$OPTARG ;;
	m) MC=$OPTARG ;;
	p) P=-p ;;
	e) ES=$OPTARG ;;
	t) T=$OPTARG ;;
	w) W=$OPTARG ;;
	o) NCO=$OPTARG ;;
	r) RO=$OPTARG ;;
	f) LO=$OPTARG ;;
	d) DLO=$OPTARG ;;
	a) ATT=$OPTARG ;;
	G) GAIN=$OPTARG ;;
	*) usage ;;
	esac
done
case $L in digital|rf) ;; *) usage ;; esac

# the transmitter interpolates by FS / SR = 2..64; the receiver's DDC
# decimation FS / (2 SR) must be one dvbs2-rx supports (1..32, larger ones
# with its CIC): ask dvbs2-rx, which applies the same rules as for -d
DEC=$((FS / (2 * SR)))
[ $((DEC * 2 * SR)) -eq $FS ] && [ $((2 * DEC)) -ge 2 ] && [ $((2 * DEC)) -le 64 ] ||
	die "symbol rate must be $FS / (2 x 1..32) (transmitter: $FS / SR = 2..64)"
dvbs2-rx --dump-coefs -s $SR -d $DEC >/dev/null 2>&1 ||
	die "dvbs2-rx does not support decimation $DEC (symbol rate $SR at $FS)"

phy=
for d in /sys/bus/iio/devices/iio:device*; do
	[ "$(cat "$d/name" 2>/dev/null)" = ad9361-phy ] && phy=${d##*/}
done
[ -n "$phy" ] || die "no ad9361-phy IIO device"
grep -q " /sys/kernel/debug " /proc/mounts || mount -t debugfs none /sys/kernel/debug
LB=/sys/kernel/debug/iio/$phy/loopback
[ -w "$LB" ] || die "no $LB"

TMP=/tmp/dvbs2-selftest.$$
mkdir -p "$TMP"
TXPID=
cleanup() {
	[ -n "$TXPID" ] && kill "$TXPID" 2>/dev/null && wait "$TXPID" 2>/dev/null
	echo 0 > "$LB"
	rx-awgn -x
	rm -rf "$TMP"
}
trap 'cleanup; exit 130' INT TERM

loopback() { [ $L = digital ] && echo 1 > "$LB"; }

echo 0 > "$LB"
rx-awgn -x
TXOPT= RXOPT=
if [ $L = rf ]; then
	TXOPT="-f $LO -a $ATT"
	RXOPT="-f $((LO + DLO))"
	[ -n "$GAIN" ] && RXOPT="$RXOPT -G $GAIN"
	echo "RF loopback: TX1 -> RX1, TX LO $LO Hz at -$ATT dB, RX LO $((LO + DLO)) Hz"
else
	echo "digital loopback (AD9363 data port TX1 -> RX1)"
fi
echo "$MC${P:+ pilots}, $SR S/s, roll-off $RO, fs $FS, TX NCO offset $NCO Hz, $T s per point"

# configure the AD9363 receive side once, then the transmitter for the whole run
dvbs2-rx -s $SR -d $DEC -m $MC -r $RO $P $RXOPT -q -O /dev/null 2>/dev/null &
pid=$!
sleep 1
kill $pid 2>/dev/null
wait $pid 2>/dev/null
ts-prbs gen | dvbs2-tx -F $FS -s $SR -m $MC -r $RO $P -o $NCO $TXOPT -i - 2>"$TMP/tx.log" &
TXPID=$!
sleep 1
kill -0 $TXPID 2>/dev/null || { cat "$TMP/tx.log"; cleanup; die "dvbs2-tx failed"; }
loopback
sleep 1

printf "%-6s %-7s %s\n" "Es/N0" "set" "result | receiver"
for e in $ES; do
	if [ "$e" = off ]; then
		rx-awgn -x
		set_es=-
	else
		set_es=$(rx-awgn -q -e "$e" -r $SR -F $FS) || { echo "$e: rx-awgn failed"; continue; }
	fi
	# the receiver starts on the noisy signal: acquisition is part of the test
	rm -f "$TMP/ts"
	mkfifo "$TMP/ts"
	ts-prbs check -t $T -w $W < "$TMP/ts" > "$TMP/res" &
	ck=$!
	dvbs2-rx -s $SR -d $DEC -m $MC -r $RO $P $RXOPT -O "$TMP/ts" 2>"$TMP/rx.log" &
	rx=$!
	sleep 1
	loopback                                 # (re)asserted after the receiver's setup
	wait $ck
	kill $rx 2>/dev/null
	wait $rx 2>/dev/null
	# the receiver's last status (its Es/N0 and frequency estimate) and its summary
	st=$(tr '\r' '\n' < "$TMP/rx.log" | grep locked | tail -1 | sed -n 's/.*locked, \([^,]*\), Es\/N0 \([^,]*\),.*/\1 Es\/N0 \2/p')
	rxs="${st:-no lock}; $(tr '\r' '\n' < "$TMP/rx.log" | grep -v '^ *$' | tail -1 | sed 's/^dvbs2-rx: //')"
	printf "%-6s %-7s %s | %s\n" "$e" "$set_es" "$(cat "$TMP/res")" "$rxs"
done

cleanup
